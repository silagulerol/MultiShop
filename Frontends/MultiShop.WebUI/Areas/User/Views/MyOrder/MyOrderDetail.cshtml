@model List<MultiShop.DtoLayer.OrderDtos.OrderDetailDtos.ResultOrderDetailDto>

@{
    ViewData["Title"] = "MyOrderDetail";
    Layout = "~/Areas/User/Views/UserLayout/Index.cshtml";
    int count = 0;
}

<div class="main-panel">
    <div class="content-wrapper">
        <div class="row">
            <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Order Details</h4>

                        <div class="table-responsive pt-3">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Product Name</th>
                                        <th>Unit Price</th>
                                        <th>Quantity</th>
                                        <th>Total Price</th>
                                        <th>Order Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        count++;
                                        <tr>
                                            <td>@count</td>
                                            <td>@item.ProductName</td>
                                            <td>@item.UnitPrice</td>
                                            <td>@item.Quantity</td>
                                            <td>@item.ProductTotalPrice</td>
                                            @{
                                                string statusClass = item.OrderStatus switch
                                                {
                                                    "Pending" => "badge badge-secondary",
                                                    "Preparing" => "badge badge-warning",
                                                    "Shipped" => "badge badge-info",
                                                    "Delivered" => "badge badge-success",
                                                    "Cancelled" => "badge badge-danger",
                                                    _ => "badge badge-dark"
                                                };
                                            }
                                            <td>
                                                <span class="@statusClass">@item.OrderStatus</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <a href="/User/MyOrder/MyOrderList" class="btn btn-primary mt-3">
                            Back To Orders
                        </a>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>