@{
    var messageCount = ViewBag.messageCount ?? 0;
    var commentCount = ViewBag.commentCount ?? 0;
    var vendorName = User.Identity?.Name ?? "Vendor";
}

<header class="main-header vendor-header">
    <a href="/Vendor/Product/Index" class="logo vendor-header-logo">
        <span class="logo-mini vendor-logo-mini">MS</span>
        <span class="logo-lg vendor-logo-lg">
            <small>Seller</small>
        </span>
    </a>

    <nav class="navbar navbar-static-top vendor-topbar" role="navigation">
        <a href="#" class="sidebar-toggle vendor-sidebar-toggle" data-toggle="push-menu" role="button">
            <span class="sr-only">Toggle navigation</span>
            <i class="fa fa-bars"></i>
        </a>

        <div class="vendor-header-search">
            <form action="#" method="get" class="search-form">
                <div class="vendor-search-shell">
                    <i class="fa fa-search"></i>
                    <input type="text" name="search" class="form-control" placeholder="Search products, orders, comments..." autocomplete="off">
                    <button type="submit" name="search" id="search-btn" class="vendor-search-button" aria-label="Search">
                        <i class="fa fa-arrow-right"></i>
                    </button>
                </div>
            </form>
        </div>

        <div class="navbar-custom-menu vendor-actions">
            <ul class="nav navbar-nav vendor-navbar-nav">
                <li class="dropdown messages-menu vendor-icon-menu">
                    <a href="#" class="dropdown-toggle vendor-icon-button" data-toggle="dropdown" aria-label="Messages">
                        <i class="fa fa-envelope-o"></i>
                        <span class="vendor-notify-badge">@messageCount</span>
                    </a>
                    <ul class="dropdown-menu vendor-dropdown vendor-notification-dropdown">
                        <li class="header vendor-dropdown-header">Messages</li>
                        <li>
                            <ul class="menu vendor-notification-list">
                                <li>
                                    <a href="#">
                                        <span class="notification-icon"><i class="fa fa-envelope-o"></i></span>
                                        <span>
                                            <strong>Vendor messages</strong>
                                            <small>You have @messageCount unread messages.</small>
                                        </span>
                                    </a>
                                </li>
                                <li>
                                    <a href="/Vendor/Order/OrderDetailList">
                                        <span class="notification-icon"><i class="fa fa-shopping-cart"></i></span>
                                        <span>
                                            <strong>Order conversations</strong>
                                            <small>Review order-related updates.</small>
                                        </span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="footer vendor-dropdown-footer"><a href="#">Check all messages</a></li>
                    </ul>
                </li>

                <li class="dropdown notifications-menu vendor-icon-menu">
                    <a href="#" class="dropdown-toggle vendor-icon-button" data-toggle="dropdown" aria-label="Notifications">
                        <i class="fa fa-bell-o"></i>
                        <span class="vendor-notify-badge">@commentCount</span>
                    </a>
                    <ul class="dropdown-menu vendor-dropdown vendor-notification-dropdown">
                        <li class="header vendor-dropdown-header">Notifications</li>
                        <li>
                            <ul class="menu vendor-notification-list">
                                <li>
                                    <a href="/Vendor/Comment/Index">
                                        <span class="notification-icon"><i class="fa fa-comments-o"></i></span>
                                        <span>
                                            <strong>Customer comments</strong>
                                            <small>@commentCount comments need your attention.</small>
                                        </span>
                                    </a>
                                </li>
                                <li>
                                    <a href="/Vendor/SpecialOffer/Index">
                                        <span class="notification-icon"><i class="fa fa-percent"></i></span>
                                        <span>
                                            <strong>Special offers</strong>
                                            <small>Manage active marketplace campaigns.</small>
                                        </span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="footer vendor-dropdown-footer"><a href="/Vendor/Comment/Index">View all</a></li>
                    </ul>
                </li>

                <li class="dropdown user user-menu vendor-user-menu">
                    <a href="#" class="dropdown-toggle vendor-profile-trigger" data-toggle="dropdown">
                        <span class="vendor-avatar"><i class="fa fa-user"></i></span>
                        <span class="vendor-profile-copy hidden-xs">
                            <small>Seller account</small>
                            <strong>@vendorName</strong>
                        </span>
                        <i class="fa fa-angle-down vendor-profile-chevron"></i>
                    </a>
                    <ul class="dropdown-menu vendor-dropdown vendor-profile-dropdown">
                        <li class="user-header vendor-profile-card">
                            <span class="vendor-profile-avatar-lg"><i class="fa fa-user"></i></span>
                            <p>
                                @vendorName
                                <small>MultiShop Vendor Panel</small>
                            </p>
                            <a href="/Vendor/Product/Index" class="vendor-profile-link">Open Dashboard</a>
                        </li>
                        <li><a href="/Vendor/Product/Index"><i class="fa fa-home"></i> Dashboard</a></li>
                        <li><a href="/Vendor/Product/GetProductsWithCategory"><i class="fa fa-shopping-bag"></i> My Products</a></li>
                        <li><a href="/Vendor/Order/OrderDetailList"><i class="fa fa-shopping-cart"></i> Orders</a></li>
                        <li role="separator" class="divider"></li>
                        <li><a href="/Default/Index"><i class="fa fa-globe"></i> Go To Website</a></li>
                        <li><a href="/LogIn/LogOut" class="vendor-profile-logout"><i class="fa fa-sign-out"></i> Logout</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </nav>
</header>

<style>
    .vendor-header {
        background: #ffffff !important;
        border-bottom: 1px solid #edf0f3;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        font-family: Poppins, Arial, sans-serif;
    }

    .vendor-header-logo {
        display: flex !important;
        align-items: center;
        justify-content: center;
        height: 64px !important;
        background: #111317 !important;
        border-right: 1px solid rgba(255, 255, 255, 0.08);
        color: #ffffff !important;
        text-decoration: none !important;
    }

    .vendor-logo-mini {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        color: #ffffff;
        background: #f27a1a;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 900;
        letter-spacing: 0;
    }

    .vendor-logo-lg {
        display: inline-flex !important;
        align-items: center;
        gap: 0;
        color: #ffffff;
        font-size: 20px;
        font-weight: 900;
        letter-spacing: 0;
        line-height: 1;
    }

    .vendor-logo-lg span,
    .vendor-logo-lg strong {
        display: inline-flex;
        align-items: center;
        height: 34px;
        padding: 0 9px;
        text-transform: uppercase;
    }

    .vendor-logo-lg span {
        color: #111317;
        background: #ffffff;
        border-radius: 8px 0 0 8px;
    }

    .vendor-logo-lg strong {
        color: #ffffff;
        background: #f27a1a;
        border-radius: 0 8px 8px 0;
    }

    .vendor-logo-lg small {
        margin-left: 8px;
        color: #9aa4b2;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .vendor-topbar {
        display: flex;
        align-items: center;
        min-height: 64px;
        margin-left: 230px;
        background: #ffffff !important;
    }

    .vendor-sidebar-toggle {
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        margin-left: 16px;
        color: #343a40 !important;
        background: #f7f8fa;
        border: 1px solid #edf0f3;
        border-radius: 12px;
        transition: background-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
    }

    .vendor-sidebar-toggle::before {
        display: none !important;
    }

    .vendor-sidebar-toggle:hover,
    .vendor-sidebar-toggle:focus {
        color: #f27a1a !important;
        background: #fff4ec;
        text-decoration: none;
        transform: translateY(-1px);
    }

    .vendor-header-search {
        flex: 1 1 auto;
        max-width: 620px;
        padding: 0 20px;
    }

    .vendor-header-search .search-form {
        margin: 0;
    }

    .vendor-search-shell {
        display: flex;
        align-items: center;
        gap: 11px;
        height: 44px;
        padding: 0 8px 0 15px;
        background: #f7f8fa;
        border: 1px solid #edf0f3;
        border-radius: 14px;
        transition: background-color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }

    .vendor-search-shell:focus-within {
        background: #ffffff;
        border-color: rgba(242, 122, 26, 0.48);
        box-shadow: 0 0 0 4px rgba(242, 122, 26, 0.09);
    }

    .vendor-search-shell > i {
        color: #8b95a1;
        font-size: 14px;
    }

    .vendor-search-shell .form-control {
        height: 42px;
        padding: 0;
        color: #1f242b;
        background: transparent;
        border: 0;
        box-shadow: none;
        font-size: 13px;
        font-weight: 600;
    }

    .vendor-search-shell .form-control::placeholder {
        color: #9aa4b2;
        font-weight: 500;
    }

    .vendor-search-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        color: #ffffff;
        background: #f27a1a;
        border: 0;
        border-radius: 10px;
        transition: background-color 0.18s ease, transform 0.18s ease;
    }

    .vendor-search-button:hover,
    .vendor-search-button:focus {
        background: #dd6b10;
        transform: translateY(-1px);
    }

    .vendor-actions {
        margin-left: auto;
        padding-right: 18px;
    }

    .vendor-navbar-nav {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
    }

    .vendor-navbar-nav > li > a {
        padding: 0 !important;
    }

    .vendor-icon-button {
        position: relative;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        color: #343a40 !important;
        background: #f7f8fa;
        border: 1px solid #edf0f3;
        border-radius: 12px;
        transition: background-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
    }

    .vendor-icon-button:hover,
    .vendor-icon-button:focus,
    .vendor-icon-menu.open > .vendor-icon-button {
        color: #f27a1a !important;
        background: #fff4ec;
        text-decoration: none;
        transform: translateY(-1px);
    }

    .vendor-icon-button i {
        font-size: 17px;
    }

    .vendor-notify-badge {
        position: absolute;
        top: -6px;
        right: -5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 19px;
        height: 19px;
        padding: 0 5px;
        color: #ffffff;
        background: #f27a1a;
        border: 2px solid #ffffff;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 900;
        line-height: 1;
    }

    .vendor-profile-trigger {
        display: inline-flex !important;
        align-items: center;
        gap: 10px;
        min-height: 46px;
        padding: 4px 8px 4px 6px !important;
        color: #1f242b !important;
        background: #ffffff;
        border: 1px solid #edf0f3;
        border-radius: 14px;
        transition: background-color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
    }

    .vendor-profile-trigger:hover,
    .vendor-profile-trigger:focus,
    .vendor-user-menu.open > .vendor-profile-trigger {
        background: #f7f8fa;
        border-color: rgba(242, 122, 26, 0.22);
        text-decoration: none;
        transform: translateY(-1px);
    }

    .vendor-avatar,
    .vendor-profile-avatar-lg {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #f27a1a;
        background: #fff4ec;
        border: 1px solid rgba(242, 122, 26, 0.16);
        border-radius: 50%;
    }

    .vendor-avatar {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
    }

    .vendor-profile-copy {
        display: flex;
        flex-direction: column;
        min-width: 0;
        line-height: 1.15;
    }

    .vendor-profile-copy small {
        color: #8b95a1;
        font-size: 11px;
        font-weight: 700;
    }

    .vendor-profile-copy strong {
        max-width: 130px;
        overflow: hidden;
        color: #1f242b;
        font-size: 13px;
        font-weight: 900;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .vendor-profile-chevron {
        color: #9aa4b2;
        font-size: 13px;
        transition: transform 0.18s ease;
    }

    .vendor-user-menu.open .vendor-profile-chevron {
        transform: rotate(180deg);
    }

    .vendor-dropdown {
        min-width: 290px !important;
        padding: 10px !important;
        margin-top: 12px !important;
        background: #ffffff !important;
        border: 1px solid #edf0f3 !important;
        border-radius: 16px !important;
        box-shadow: 0 18px 48px rgba(15, 23, 42, 0.16) !important;
        overflow: hidden;
    }

    .vendor-dropdown-header {
        padding: 8px 10px 12px !important;
        color: #1f242b !important;
        background: transparent !important;
        border-bottom: 1px solid #f1f3f5 !important;
        font-size: 14px !important;
        font-weight: 900 !important;
    }

    .vendor-notification-list {
        max-height: 280px;
        padding: 6px 0 !important;
        margin: 0 !important;
    }

    .vendor-notification-list li a {
        display: flex !important;
        align-items: center;
        gap: 12px;
        padding: 10px !important;
        color: #343a40 !important;
        border-radius: 11px;
        transition: background-color 0.18s ease, color 0.18s ease;
    }

    .vendor-notification-list li a:hover {
        background: #f7f8fa !important;
        color: #f27a1a !important;
        text-decoration: none;
    }

    .notification-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        flex: 0 0 36px;
        color: #f27a1a;
        background: #fff4ec;
        border-radius: 11px;
    }

    .vendor-notification-list strong,
    .vendor-notification-list small {
        display: block;
        line-height: 1.35;
    }

    .vendor-notification-list strong {
        color: #1f242b;
        font-size: 13px;
        font-weight: 900;
    }

    .vendor-notification-list small {
        margin-top: 2px;
        color: #8b95a1;
        font-size: 12px;
        font-weight: 600;
    }

    .vendor-dropdown-footer {
        padding: 8px 10px 2px !important;
        border-top: 1px solid #f1f3f5 !important;
        background: transparent !important;
    }

    .vendor-dropdown-footer a {
        color: #f27a1a !important;
        font-size: 13px;
        font-weight: 900;
    }

    .vendor-profile-dropdown {
        min-width: 270px !important;
        padding: 10px !important;
    }

    .vendor-profile-card {
        display: flex !important;
        align-items: center;
        gap: 12px;
        min-height: auto !important;
        padding: 12px !important;
        color: #1f242b !important;
        background: #f7f8fa !important;
        border-radius: 14px;
    }

    .vendor-profile-avatar-lg {
        width: 46px;
        height: 46px;
        flex: 0 0 46px;
        font-size: 18px;
    }

    .vendor-profile-card p {
        flex: 1;
        margin: 0 !important;
        color: #1f242b !important;
        font-size: 14px !important;
        font-weight: 900;
        text-align: left !important;
    }

    .vendor-profile-card p small {
        display: block;
        margin-top: 3px;
        color: #8b95a1 !important;
        font-size: 12px;
        font-weight: 600;
    }

    .vendor-profile-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 10px;
        color: #ffffff !important;
        background: #f27a1a;
        border-radius: 10px;
        font-size: 11px;
        font-weight: 900;
        white-space: nowrap;
    }

    .vendor-profile-dropdown > li:not(.user-header):not(.divider) > a {
        display: flex !important;
        align-items: center;
        gap: 10px;
        padding: 10px 11px !important;
        color: #343a40 !important;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 800;
        transition: background-color 0.18s ease, color 0.18s ease;
    }

    .vendor-profile-dropdown > li:not(.user-header):not(.divider) > a i {
        width: 18px;
        color: #9aa4b2;
        text-align: center;
    }

    .vendor-profile-dropdown > li:not(.user-header):not(.divider) > a:hover {
        color: #f27a1a !important;
        background: #f7f8fa !important;
        text-decoration: none;
    }

    .vendor-profile-dropdown > li:not(.user-header):not(.divider) > a:hover i {
        color: #f27a1a;
    }

    .vendor-profile-dropdown .divider {
        margin: 7px 4px !important;
        background-color: #f1f3f5 !important;
    }

    .vendor-profile-logout:hover {
        color: #dc3545 !important;
        background: #fff5f5 !important;
    }

    .vendor-profile-logout:hover i {
        color: #dc3545 !important;
    }

    .content-wrapper {
        background: #f6f7f9 !important;
    }

    .main-footer {
        background: #ffffff !important;
        border-top: 1px solid #edf0f3 !important;
        color: #7b8491 !important;
    }

    @@media (max-width: 991.98px) {
        .vendor-topbar {
            margin-left: 0;
        }

        .vendor-header-search {
            max-width: none;
            padding: 0 10px;
        }

        .vendor-search-shell .form-control {
            font-size: 12px;
        }

        .vendor-actions {
            padding-right: 10px;
        }
    }

    @@media (max-width: 767.98px) {
        .vendor-header-logo {
            width: 64px !important;
        }

        .vendor-logo-lg {
            display: none !important;
        }

        .vendor-topbar {
            min-height: 60px;
        }

        .vendor-sidebar-toggle {
            width: 40px;
            height: 40px;
            margin-left: 10px;
        }

        .vendor-header-search {
            display: none;
        }

        .vendor-navbar-nav {
            gap: 6px;
        }

        .vendor-icon-button {
            width: 39px;
            height: 39px;
        }

        .vendor-profile-trigger {
            min-height: 41px;
            padding: 3px 7px 3px 4px !important;
        }

        .vendor-profile-chevron {
            display: none;
        }

        .vendor-dropdown {
            right: 0 !important;
            left: auto !important;
            min-width: min(290px, calc(100vw - 24px)) !important;
        }
    }
</style>
