@model UpdateProductVariantDto
@{
    ViewData["Title"] = "UpdateProductVariant";
    Layout = "~/Areas/Vendor/Views/VendorLayout/Index.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Update Product Variant</h4>
                <br />
                <div class="bs-example" data-example-id="bordered-table">
                    <form method="post">
                        <input type="hidden" asp-for="ProductVariantId" />
                        <input type="hidden" asp-for="ProductId" />

                        <label>Variant Name</label>
                        <input type="text" class="form-control" asp-for="VariantName" />
                        <br />

                        <label>SKU</label>
                        <input type="text" class="form-control" asp-for="Sku" />
                        <br />

                        <label>Size</label>
                        <input type="text" class="form-control" asp-for="Size" />
                        <br />

                        <label>Color</label>
                        <input type="text" class="form-control" asp-for="Color" />
                        <br />

                        <label>Color Hex Code</label>
                        <input type="text" class="form-control" asp-for="ColorHexCode" />
                        <br />

                        <label>Price</label>
                        <input type="number" step="0.01" min="0" class="form-control" asp-for="Price" />
                        <br />

                        <label>Discounted Price</label>
                        <input type="number" step="0.01" min="0" class="form-control" asp-for="DiscountedPrice" />
                        <br />

                        <label>Discount Rate</label>
                        <input type="number" min="0" class="form-control" asp-for="DiscountRate" />
                        <br />

                        <label>Stock</label>
                        <input type="number" min="0" class="form-control" asp-for="Stock" />
                        <br />

                        <label>Max Order Quantity</label>
                        <input type="number" min="0" class="form-control" asp-for="MaxOrderQuantity" />
                        <br />

                        <label>Main Image Url</label>
                        <input type="text" class="form-control" asp-for="MainImageUrl" />
                        <br />

                        <label>Is Available</label>
                        <input type="checkbox" asp-for="IsAvailable" />
                        <br />

                        <button class="btn btn-primary">Update Variant</button>
                        <a href="/Vendor/ProductVariant/ProductVariantList/@Model.ProductId" class="btn btn-secondary">Back To Variants</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
