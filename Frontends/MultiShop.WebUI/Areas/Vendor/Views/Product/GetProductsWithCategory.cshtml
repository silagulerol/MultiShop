@model List<ResultProductWithCategoryDto>
@{
    ViewData["Title"] = "GetProductsWithCategory";
    Layout = "~/Areas/Vendor/Views/VendorLayout/Index.cshtml";
    int count = 0;
}


<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <div class="bs-example" data-example-id="bordered-table">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Product Name</th>
                                <th>Starting Price</th>
                                <th>Category Name</th>
                                <th>Product Images</th>
                                <th>Product Details</th>
                                <th>Variants</th>
                                <th>Delete</th>
                                <th>Update</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <th scope="row">@count</th>
                                    <td>@item.ProductName</td>
                                    <td>@item.StartingPrice</td>
                                    <td>@item.Category?.Name</td>
                                    <td><a href="/Vendor/ProductImage/ProductImageDetail/@item.ProductId" class="btn btn-warning">Product Images</a></td>
                                    <td><a href="/Vendor/ProductDetail/UpdateProductDetail/@item.ProductId" class="btn btn-warning">Product Details</a></td>
                                    <td><a href="/Vendor/ProductVariant/ProductVariantList/@item.ProductId" class="btn btn-info">Variants</a></td>
                                    <td><a href="/Vendor/Product/DeleteProduct/@item.ProductId" class="btn btn-danger">Delete</a></td>
                                    <td><a href="/Vendor/Product/UpdateProduct/@item.ProductId" class="btn btn-success">Update</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/Vendor/Product/CreateProduct" class="btn btn-primary">Add New Product</a>
                </div>
            </div>
        </div>
    </div>
</section>
