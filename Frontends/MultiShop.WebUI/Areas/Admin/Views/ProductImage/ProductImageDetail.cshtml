@model UpdateProductImageDto
@{
    ViewData["Title"] = "ProductImageDetail";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Update Product Image</h4>
                <br />
                <div class="bs-example" data-example-id="bordered-table">

                    <form method="post">
                        <input type="hidden" readonly class="form-control" asp-for="@Model.ProductImageId">
                        <input type="hidden" readonly class="form-control" asp-for="@Model.ProductId">
                        <input type="hidden" readonly class="form-control" asp-for="@Model.CreatedDate">
                        <label>Image Url</label>
                        <input type="text" class="form-control" asp-for="@Model.ImageUrl" />
                        <br />
                        <label>Display Order</label>
                        <input type="number" class="form-control" asp-for="@Model.DisplayOrder">
                        <br />
                        <label>Image Alt Text</label>
                        <input type="text" class="form-control" asp-for="@Model.ImageAltText">
                        <br />
                        <label>Image Type</label>
                        <input type="text" class="form-control" asp-for="@Model.ImageType">
                        <br />
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" asp-for="@Model.IsMainImage">
                            <label class="form-check-label" asp-for="@Model.IsMainImage">Main Image</label>
                        </div>
                        <br />
                        <button class="btn btn-primary">Update Product Image</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
