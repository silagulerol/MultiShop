@model List<ResultProductDto>

@{
    ViewData["Title"] = "Search Results";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
    var favoriteProductIds = ViewBag.FavoriteProductIds as HashSet<string> ?? new HashSet<string>();
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<style>
    .search-results-shell {
        background: #f7f7f8;
    }

    .search-results-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 26px;
    }

    .search-results-title {
        margin: 0;
        color: #1f1f1f;
        font-size: 28px;
        font-weight: 700;
    }

    .search-results-subtitle {
        margin: 6px 0 0;
        color: #747474;
        font-size: 14px;
    }

    .search-product-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 28px;
        align-items: stretch;
    }

    .search-product-card {
        height: 520px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid #ececec;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
        transition: box-shadow .2s ease, transform .2s ease;
    }

    .search-product-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.1);
    }

    .search-product-image-wrapper {
        position: relative;
        height: 260px;
        width: 100%;
        overflow: hidden;
        background: #f3f3f3;
    }

    .search-product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .search-badge-row {
        position: absolute;
        top: 12px;
        left: 12px;
        right: 12px;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        justify-content: flex-start;
        pointer-events: none;
    }

    .search-product-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 18px;
        text-align: center;
        min-width: 0;
    }

    .search-product-meta {
        min-height: 36px;
        margin-bottom: 8px;
        color: #777;
        font-size: 12px;
        line-height: 18px;
        text-transform: uppercase;
    }

    .search-product-meta span {
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .search-product-title {
        min-height: 48px;
        max-height: 48px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        color: #2f2f2f;
        font-size: 15px;
        font-weight: 600;
        line-height: 24px;
        text-decoration: none;
        word-break: break-word;
    }

    .search-product-title:hover {
        color: #f7941d;
        text-decoration: none;
    }

    .search-card-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        justify-content: center;
        min-height: 28px;
        margin-top: 12px;
        overflow: hidden;
    }

    .search-product-price {
        margin-top: auto;
        min-height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .search-product-price h5,
    .search-product-price h6 {
        margin: 0;
    }

    .search-product-rating {
        min-height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 10px;
        white-space: nowrap;
    }

    .search-empty-state {
        border: 1px solid #ececec;
        border-radius: 8px;
        background: #fff;
        padding: 44px 24px;
        text-align: center;
        color: #666;
    }

    .search-empty-state h4 {
        color: #222;
        margin-bottom: 8px;
    }

    @@media (max-width: 1199.98px) {
        .search-product-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 991.98px) {
        .search-product-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 22px;
        }

        .search-results-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @@media (max-width: 575.98px) {
        .search-product-grid {
            grid-template-columns: 1fr;
        }

        .search-product-card {
            height: 500px;
        }

        .search-product-image-wrapper {
            height: 240px;
        }

        .product-action.product-card-actions {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
    }
</style>

<div class="container-fluid pt-5 pb-5 search-results-shell">
    <div class="px-xl-5">

        <div class="search-results-header">
            <div>
                <h2 class="search-results-title">Search Results</h2>
                <p class="search-results-subtitle">Results for "@ViewBag.SearchKey"</p>
            </div>
            @if (Model != null && Model.Any())
            {
                <span class="text-muted small">@Model.Count product@(Model.Count == 1 ? "" : "s") found</span>
            }
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="search-empty-state">
                <h4>No products found.</h4>
                <p class="mb-0">Try searching with a different product, brand, category, or variant term.</p>
            </div>
        }
        else
        {
            <div class="search-product-grid">
                @foreach (var item in Model)
                {
                    var hasDiscount = item.StartingDiscountedPrice.HasValue && item.StartingDiscountedPrice.Value < item.StartingPrice;
                    var displayPrice = hasDiscount ? item.StartingDiscountedPrice!.Value : item.StartingPrice;
                    var rating = Math.Clamp(item.AverageRating, 0, 5);
                    var imageUrl = string.IsNullOrWhiteSpace(item.MainImageUrl) ? "/multishop/img/no-image.png" : item.MainImageUrl;

                    <div class="product-item search-product-card">
                        <div class="product-img search-product-image-wrapper">
                            <img class="search-product-image" src="@imageUrl" alt="@item.ProductName">
                            <div class="search-badge-row">
                                @if (hasDiscount)
                                {
                                    <span class="badge badge-danger">%@item.MaxDiscountRate</span>
                                }
                                @if (item.IsFreeShipping)
                                {
                                    <span class="badge badge-primary">Free Shipping</span>
                                }
                            </div>

                            <div class="product-action product-card-actions">
                                <a class="btn btn-outline-dark btn-square" href="/ProductList/ProductDetail/@item.ProductId">
                                    <i class="fa fa-shopping-cart"></i>
                                </a>
                                <form asp-controller="Favorite" asp-action="ToggleFavorite" method="post" class="favorite-form">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-outline-dark btn-square favorite-btn">
                                        <i class="@(favoriteProductIds.Contains(item.ProductId) ? "fas" : "far") fa-heart"></i>
                                    </button>
                                </form>
                                <a class="btn btn-outline-dark btn-square" href="">
                                    <i class="fa fa-sync-alt"></i>
                                </a>
                                <a class="btn btn-outline-dark btn-square" href="/ProductList/ProductDetail/@item.ProductId">
                                    <i class="fa fa-search"></i>
                                </a>
                            </div>
                        </div>

                        <div class="search-product-body">
                            <div class="search-product-meta">
                                @if (!string.IsNullOrWhiteSpace(item.BrandName))
                                {
                                    <span>@item.BrandName</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.CategoryName))
                                {
                                    <span>@item.CategoryName</span>
                                }
                            </div>

                            <a class="search-product-title" href="/ProductList/ProductDetail/@item.ProductId">
                                @item.ProductName
                            </a>

                            <div class="search-card-badges">
                                @if (!string.IsNullOrWhiteSpace(item.BadgeText))
                                {
                                    <small class="badge badge-info">@item.BadgeText</small>
                                }
                                @if (item.IsBestSeller)
                                {
                                    <small class="badge badge-warning">Best Seller</small>
                                }
                                @if (item.IsNewArrival)
                                {
                                    <small class="badge badge-success">New</small>
                                }
                            </div>

                            <div class="search-product-price">
                                <h5>@displayPrice.ToString("N2") ₺</h5>
                                @if (hasDiscount)
                                {
                                    <h6 class="text-muted">
                                        <del>@item.StartingPrice.ToString("N2") ₺</del>
                                    </h6>
                                }
                            </div>

                            <div class="search-product-rating">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    if (rating >= i)
                                    {
                                        <small class="fa fa-star text-primary mr-1"></small>
                                    }
                                    else if (rating >= i - 0.5)
                                    {
                                        <small class="fas fa-star-half-alt text-primary mr-1"></small>
                                    }
                                    else
                                    {
                                        <small class="far fa-star text-primary mr-1"></small>
                                    }
                                }
                                <small>@item.AverageRating.ToString("0.0") (@item.ReviewCount)</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
