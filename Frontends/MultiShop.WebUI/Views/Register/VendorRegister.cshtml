@model MultiShop.DtoLayer.IdentityDtos.RegisterDtos.CreateRegisterDto

@{
    ViewData["Title"] = "Vendor Register";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-11">
            <div class="card p-4">
                <h3 class="mb-4">Vendor Register</h3>

               <form method="post">
                    <input type="hidden" asp-for="Role" value="Vendor" />
                    <div class="row">
                        <!-- LEFT -->
                        <div class="col-md-6">
                            <h5 class="mb-3">Account Information</h5>
                            <div class="form-group">
                                <label>Name</label>
                                <input asp-for="Name" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label>Surname</label>
                                <input asp-for="Surname" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label>Username</label>
                                <input asp-for="UserName" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label>Email</label>
                                <input asp-for="Email" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label>Password</label>
                                <input asp-for="Password" type="password" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label>Confirm Password</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" />
                            </div>

                        </div>

                        <!-- RIGHT -->
                        <div class="col-md-6">

                            <h5 class="mb-3">Store Information</h5>

                            <div class="form-group">
                                <label>Store Name</label>
                                <input asp-for="StoreName" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label>Company Name</label>
                                <input asp-for="CompanyName" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label>Tax Number</label>
                                <input asp-for="TaxNumber" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label>Phone</label>
                                <input asp-for="Phone" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label>Address</label>
                                <textarea asp-for="Address" class="form-control" rows="6"></textarea>
                            </div>

                        </div>

                    </div>

                    <button type="submit" class="btn btn-primary btn-block mt-4">
                        Create Vendor Account
                    </button>

                </form>
            </div>
        </div>
    </div>
</div>