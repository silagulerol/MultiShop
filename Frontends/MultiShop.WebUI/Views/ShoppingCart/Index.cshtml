@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<div class="container-fluid shopping-cart-page">
    <div class="shopping-cart-shell">
        <div class="shopping-cart-main">
            <div class="shopping-cart-heading">
                <span>Shopping cart</span>
                <h1>Your Bag</h1>
            </div>

            @await Component.InvokeAsync("_ShoppingCartProductListComponentPartial")
        </div>

        <aside class="shopping-cart-summary-panel">
            @await Html.PartialAsync("~/Views/Discount/ConfirmDiscountCoupon.cshtml")
            @await Component.InvokeAsync("_ShoppingCartProceedCheckoutComponentPartial")
        </aside>
    </div>

    <div class="cart-recommendations">
        @await Component.InvokeAsync("_ProductYouLikeComponentPartial")
    </div>
</div>

@*@await Component.InvokeAsync("_ShoppingCartDiscountCouponComponentPartial")*@
