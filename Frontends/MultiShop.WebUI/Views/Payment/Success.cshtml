@{
    ViewData["Title"] = "Payment Success";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<div class="container mt-5 text-center">
    <h2 class="text-success">Payment Successful</h2>
    <p>Your order has been completed successfully.</p>

    <div class="alert alert-success mt-4">
        <p><strong>Order ID:</strong> @ViewBag.OrderingId</p>
        <p><strong>Total Price:</strong> $@ViewBag.TotalPrice</p>
    </div>

    <a href="/User/MyOrder/MyOrderList" class="btn btn-primary mt-3">
        Go to My Orders
    </a>

    <a href="/" class="btn btn-primary mt-3">
        Continue Shopping
    </a>
</div>