@{
    ViewData["Title"] = "Payment Failed";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<div class="container mt-5 text-center">
    <h2 class="text-danger">Payment Failed</h2>
    <p>Something went wrong during payment.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mt-4">
            @ViewBag.Error
        </div>
    }

    <a href="/Payment" class="btn btn-warning mt-3">
        Try Again
    </a>

    <a href="/ShoppingCart" class="btn btn-outline-primary mt-3">
        Back to Cart
    </a>
</div>