@{
    ViewData["Title"] = "Payment";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

<div class="container-fluid checkout-page payment-page">
    <div class="payment-heading">
        <h1>Payment</h1>
        <p>Please select your payment method and complete your payment.</p>
    </div>

    <form method="post" asp-controller="Payment" asp-action="Index" class="payment-form">
        <input type="hidden" name="addressId" value="@ViewBag.AddressId" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="payment-grid">
            <div class="payment-main">
                <section class="checkout-card payment-section-card">
                    <div class="checkout-card-header">
                        <h5>Payment Method</h5>
                    </div>

                    <div class="payment-method-list">
                        <label class="payment-method-item is-selected" for="paymentMethodCreditCard">
                            <input type="radio" id="paymentMethodCreditCard" name="paymentMethod" value="CreditCard" checked required>
                            <span>
                                <strong>CreditCard</strong>
                                <small>Pay securely with your credit card</small>
                            </span>
                        </label>

                        <label class="payment-method-item" for="paymentMethodPaypal">
                            <input type="radio" id="paymentMethodPaypal" name="paymentMethod" value="Paypal" required>
                            <span>
                                <strong>Paypal</strong>
                                <small>Pay with your PayPal account</small>
                            </span>
                        </label>

                        <label class="payment-method-item" for="paymentMethodBankTransfer">
                            <input type="radio" id="paymentMethodBankTransfer" name="paymentMethod" value="BankTransfer" required>
                            <span>
                                <strong>BankTransfer</strong>
                                <small>Pay via bank transfer</small>
                            </span>
                        </label>

                        <label class="payment-method-item" for="paymentMethodUsePoints">
                            <input type="radio" id="paymentMethodUsePoints" name="paymentMethod" value="UsePoints" required>
                            <span>
                                <strong>UsePoints</strong>
                                <small>Pay with your points</small>
                            </span>
                        </label>
                    </div>
                </section>

                <section class="checkout-card payment-section-card credit-card-section">
                    <div class="checkout-card-header">
                        <h5>Credit Card Information</h5>
                    </div>

                    <div class="card-preview">
                        <div class="front">
                            <div class="image">
                                <img src="~/image/chip.png" alt="">
                                <img src="~/image/visa.png" alt="">
                            </div>
                            <div class="card-number-box">################</div>
                            <div class="card-preview-footer">
                                <div>
                                    <span>Card Holder</span>
                                    <div class="card-holder-name">full name</div>
                                </div>
                                <div>
                                    <span>Expiration Date</span>
                                    <div>
                                        <span class="exp-month">mm</span>
                                        <span>/</span>
                                        <span class="exp-year">yy</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="back">
                            <div class="stripe"></div>
                            <div class="card-back-content">
                                <span>CVV</span>
                                <div class="cvv-box"></div>
                                <img src="~/image/visa.png" alt="">
                            </div>
                        </div>
                    </div>

                    <div class="payment-fields">
                        <div class="form-group">
                            <label>Card Number</label>
                            <input type="text" maxlength="16" class="form-control card-number-input credit-card-input" name="cardNumber" required>
                        </div>

                        <div class="form-group">
                            <label>Card Holder</label>
                            <input type="text" class="form-control card-holder-input credit-card-input" name="cardHolder" required>
                        </div>

                        <div class="payment-field-row">
                            <div class="form-group">
                                <label>Month</label>
                                <select class="form-control month-input credit-card-input" name="month" required>
                                    <option value="" disabled selected>Select Month</option>
                                    <option value="01">01</option>
                                    <option value="02">02</option>
                                    <option value="03">03</option>
                                    <option value="04">04</option>
                                    <option value="05">05</option>
                                    <option value="06">06</option>
                                    <option value="07">07</option>
                                    <option value="08">08</option>
                                    <option value="09">09</option>
                                    <option value="10">10</option>
                                    <option value="11">11</option>
                                    <option value="12">12</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label>Year</label>
                                <select class="form-control year-input credit-card-input" name="year" required>
                                    <option value="" disabled selected>Select Year</option>
                                    <option value="2026">2026</option>
                                    <option value="2027">2027</option>
                                    <option value="2028">2028</option>
                                    <option value="2029">2029</option>
                                    <option value="2030">2030</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label>CVV</label>
                                <input type="text" maxlength="4" class="form-control cvv-input credit-card-input" name="cvv" required>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <aside class="payment-sidebar">
                <div class="checkout-card payment-complete-card">
                    <h5>Complete Your Payment</h5>
                    <p>Your selected payment method will be saved with this order.</p>
                    <input type="submit" value="Complete Payment" class="btn checkout-primary-btn btn-block font-weight-bold py-3">
                </div>
            </aside>
        </div>
    </form>
</div>

<script>
    const paymentMethodInputs = document.querySelectorAll('input[name="paymentMethod"]');
    const paymentMethodItems = document.querySelectorAll('.payment-method-item');
    const creditCardSections = document.querySelectorAll('.credit-card-section');
    const creditCardInputs = document.querySelectorAll('.credit-card-input');

    function updateCreditCardFields() {
        const selectedPaymentMethod = document.querySelector('input[name="paymentMethod"]:checked')?.value;
        const isCreditCard = selectedPaymentMethod === 'CreditCard';

        creditCardSections.forEach((section) => {
            section.style.display = isCreditCard ? '' : 'none';
        });

        creditCardInputs.forEach((input) => {
            if (isCreditCard) {
                input.setAttribute('required', 'required');
            } else {
                input.removeAttribute('required');
            }
        });

        paymentMethodItems.forEach((item) => {
            const input = item.querySelector('input[name="paymentMethod"]');
            item.classList.toggle('is-selected', input.checked);
        });
    }

    paymentMethodInputs.forEach((input) => {
        input.addEventListener('change', updateCreditCardFields);
    });

    updateCreditCardFields();

    document.querySelector('.card-number-input').oninput = () => {
        document.querySelector('.card-number-box').innerText = document.querySelector('.card-number-input').value || '################';
    }

    document.querySelector('.card-holder-input').oninput = () => {
        document.querySelector('.card-holder-name').innerText = document.querySelector('.card-holder-input').value || 'full name';
    }

    document.querySelector('.month-input').oninput = () => {
        document.querySelector('.exp-month').innerText = document.querySelector('.month-input').value || 'mm';
    }

    document.querySelector('.year-input').oninput = () => {
        document.querySelector('.exp-year').innerText = document.querySelector('.year-input').value || 'yy';
    }

    document.querySelector('.cvv-input').onmouseenter = () => {
        document.querySelector('.front').style.transform = 'perspective(1000px) rotateY(-180deg)';
        document.querySelector('.back').style.transform = 'perspective(1000px) rotateY(0deg)';
    }

    document.querySelector('.cvv-input').onmouseleave = () => {
        document.querySelector('.front').style.transform = 'perspective(1000px) rotateY(0deg)';
        document.querySelector('.back').style.transform = 'perspective(1000px) rotateY(180deg)';
    }

    document.querySelector('.cvv-input').oninput = () => {
        document.querySelector('.cvv-box').innerText = document.querySelector('.cvv-input').value;
    }
</script>
