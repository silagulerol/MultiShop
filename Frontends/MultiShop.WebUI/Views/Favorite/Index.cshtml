@model List<ResultFavoriteDto>

@{
    ViewData["Title"] = "Favorites";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<style>
    .favorites-page {
        padding: 42px 0 56px;
        background: #f5f5f5;
    }

    .favorites-page * {
        box-sizing: border-box;
    }

    .favorites-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
    }

    .favorites-header h2 {
        margin: 0 0 4px;
        color: #1f252a;
        font-size: 28px;
        font-weight: 700;
    }

    .favorites-header p {
        margin: 0;
        color: #6C757D;
    }

    .favorites-continue-link {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 16px;
        border: 1px solid #3D464D;
        border-radius: 6px;
        background: #FFFFFF;
        color: #3D464D;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
    }

    .favorites-continue-link:hover {
        border-color: #FFD333;
        background: #FFD333;
        color: #3D464D;
        text-decoration: none;
    }

    .favorites-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px;
        border: 1px solid #ececec;
        border-radius: 8px;
        background: #FFFFFF;
    }

    .favorites-tabs {
        display: inline-flex;
        gap: 8px;
    }

    .favorites-tab,
    .favorite-filter-chips button {
        font-family: inherit;
        cursor: pointer;
    }

    .favorites-tab {
        min-height: 38px;
        padding: 0 18px;
        border: 1px solid #e7e7e7;
        border-radius: 999px;
        background: #FFFFFF;
        color: #3D464D;
        font-weight: 600;
    }

    .favorites-tab.active {
        border-color: #FFD333;
        background: #FFD333;
    }

    .favorites-search {
        min-width: 280px;
        height: 42px;
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        padding: 0 14px;
        border: 1px solid #e5e5e5;
        border-radius: 999px;
        background: #fafafa;
        color: #6C757D;
    }

    .favorites-search input {
        width: 100%;
        min-width: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: #3D464D;
        font: inherit;
    }

    .favorite-filter-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 16px 0 22px;
    }

    .favorite-filter-chips button {
        height: 36px;
        padding: 0 14px;
        border: 1px solid #e3e3e3;
        border-radius: 999px;
        background: #FFFFFF;
        color: #3D464D;
        font-weight: 500;
    }

    .favorite-filter-chips button:hover {
        border-color: #FFD333;
        background: #fff8db;
    }

    .favorite-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 20px;
        align-items: stretch;
    }

    .favorite-card {
        height: 430px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid #e8e8e8;
        border-radius: 8px;
        background: #FFFFFF;
        transition: box-shadow .22s ease, transform .22s ease, border-color .22s ease;
    }

    .favorite-card:hover {
        border-color: #FFD333;
        box-shadow: 0 14px 30px rgba(15, 23, 42, .10);
        transform: translateY(-2px);
    }

    .favorite-card-media {
        position: relative;
        height: 240px;
        flex: 0 0 240px;
        overflow: hidden;
        background: #f8f8f8;
    }

    .favorite-card-media a {
        width: 100%;
        height: 100%;
        display: block;
    }

    .favorite-card-image {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center;
        transition: transform .28s ease;
    }

    .favorite-card:hover .favorite-card-image {
        transform: scale(1.035);
    }

    .favorite-remove-form {
        position: absolute;
        top: 10px;
        right: 10px;
        margin: 0;
        padding: 0;
        line-height: 1;
    }

    .favorite-remove-btn {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 1px solid rgba(255, 255, 255, .9);
        border-radius: 50%;
        background: rgba(255, 255, 255, .96);
        color: #f05a28;
        box-shadow: 0 8px 18px rgba(15, 23, 42, .14);
        cursor: pointer;
    }

    .favorite-remove-btn:hover {
        background: #fff2ea;
        color: #dc3545;
    }

    .favorite-card-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
        padding: 13px 14px 14px;
    }

    .favorite-card-title {
        min-height: 42px;
        max-height: 42px;
        display: -webkit-box;
        overflow: hidden;
        color: #252b31;
        font-size: 14px;
        font-weight: 600;
        line-height: 1.45;
        text-decoration: none;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        word-break: break-word;
    }

    .favorite-card-title:hover {
        color: #f05a28;
        text-decoration: none;
    }

    .favorite-card-rating {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 8px;
        color: #8a8f94;
        font-size: 12px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .favorite-card-rating i {
        color: #FFD333;
    }

    .favorite-card-price {
        margin-top: auto;
        color: #f05a28;
        font-size: 18px;
        font-weight: 700;
    }

    .favorite-cart-btn {
        width: 100%;
        min-height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 12px;
        border: 1px solid #FFD333;
        border-radius: 6px;
        background: #FFD333;
        color: #3D464D;
        font-weight: 700;
        text-decoration: none;
    }

    .favorite-cart-btn:hover {
        background: #f5c400;
        color: #3D464D;
        text-decoration: none;
    }

    .favorites-empty-state {
        padding: 56px 20px;
        border: 1px solid #ececec;
        border-radius: 8px;
        background: #FFFFFF;
        text-align: center;
    }

    .favorites-empty-icon {
        width: 72px;
        height: 72px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        border-radius: 50%;
        background: #fff8db;
        color: #f05a28;
        font-size: 30px;
    }

    .favorites-empty-state h4 {
        margin-bottom: 8px;
        color: #252b31;
    }

    .favorites-empty-state p {
        margin-bottom: 22px;
        color: #6C757D;
    }

    @@media (max-width: 1199.98px) {
        .favorite-grid {
            grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        }
    }

    @@media (max-width: 991.98px) {
        .favorites-toolbar,
        .favorites-header {
            align-items: stretch;
            flex-direction: column;
        }

        .favorites-search {
            min-width: 0;
        }
    }

    @@media (max-width: 575.98px) {
        .favorites-page {
            padding-top: 28px;
        }

        .favorite-grid {
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 14px;
        }

        .favorite-card {
            height: 390px;
        }

        .favorite-card-media {
            height: 210px;
            flex-basis: 210px;
        }

        .favorites-tabs,
        .favorites-search {
            width: 100%;
        }

        .favorites-tab {
            flex: 1;
        }
    }
</style>

<div class="favorites-page">
    <div class="px-xl-5">
        <div class="favorites-header">
            <div>
                <h2>Favorites</h2>
                <p>Products you saved for later.</p>
            </div>
            <a href="/Default/Index" class="favorites-continue-link">Continue Shopping</a>
        </div>

        <div class="favorites-toolbar">
            <div class="favorites-tabs" role="tablist" aria-label="Favorite sections">
                <button type="button" class="favorites-tab active">Favorites</button>
                <button type="button" class="favorites-tab">Collections</button>
            </div>
            <label class="favorites-search">
                <i class="fa fa-search"></i>
                <input type="search" placeholder="Search in favorites" aria-label="Search in favorites">
            </label>
        </div>

        <div class="favorite-filter-chips" aria-label="Favorite filters">
            <button type="button">Category</button>
            <button type="button">Price Drops</button>
            <button type="button">Free Shipping</button>
            <button type="button">In Stock</button>
            <button type="button">Best Seller</button>
        </div>

        @if (Model is null || !Model.Any())
        {
            <div class="favorites-empty-state">
                <span class="favorites-empty-icon"><i class="far fa-heart"></i></span>
                <h4>No favorite products yet.</h4>
                <p>Start exploring products and save the ones you like.</p>
                <a href="/Default/Index" class="btn btn-primary">Start Shopping</a>
            </div>
        }
        else
        {
            <div class="favorite-grid">
                @foreach (var item in Model)
                {
                    var imageUrl = string.IsNullOrWhiteSpace(item.MainImageUrl) ? "/multishop/img/no-image.png" : item.MainImageUrl;
                    var productName = string.IsNullOrWhiteSpace(item.ProductName) ? "Product" : item.ProductName;
                    var price = item.StartingPrice ?? 0;

                    <article class="favorite-card">
                        <div class="favorite-card-media">
                            <a href="/ProductList/ProductDetail/@item.ProductId" aria-label="@productName">
                                <img class="favorite-card-image" src="@imageUrl" alt="@productName">
                            </a>
                            <form asp-controller="Favorite" asp-action="ToggleFavorite" method="post" class="favorite-remove-form">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="favorite-remove-btn" aria-label="Remove from favorites">
                                    <i class="fas fa-heart"></i>
                                </button>
                            </form>
                        </div>

                        <div class="favorite-card-body">
                            <a class="favorite-card-title" href="/ProductList/ProductDetail/@item.ProductId">@productName</a>
                            <div class="favorite-card-rating">
                                <i class="fa fa-star"></i>
                                <span>Saved favorite</span>
                            </div>
                            <div class="favorite-card-price">@price.ToString("N2") ₺</div>
                            <a class="favorite-cart-btn" href="/ShoppingCart/AddBasketItem/@item.ProductId">Add to Cart</a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>
