<form class="cart-coupon-form" asp-controller="Discount" asp-action="ConfirmDiscountCoupon" method="post">
    <label for="cart-coupon-code">Coupon Code</label>
    <div class="cart-coupon-row">
        <input id="cart-coupon-code" type="text" name="code" class="form-control" placeholder="Enter code">
        <button class="btn" type="submit">Apply</button>
    </div>
</form>
