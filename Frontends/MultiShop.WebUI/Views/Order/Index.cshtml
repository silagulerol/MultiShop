@model CheckoutAddressDto

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

<form method="post" asp-controller="Order" asp-action="Index">
    <div class="container-fluid checkout-page order-checkout-page">
        <div class="row">
            <div class="col-lg-8">
                <h5 class="section-title position-relative text-uppercase mb-3">
                    <span class="bg-secondary pr-3">Order Delivery and Billing Address</span>
                </h5>

                @if (Model.ExistingAddresses.Any())
                {
                    <div class="checkout-card p-30 mb-4">
                        <h6 class="mb-3">Saved Addresses</h6>

                        @foreach (var address in Model.ExistingAddresses)
                        {
                            <div class="custom-control custom-radio mb-3">
                                <input type="radio"
                                       class="custom-control-input checkout-address-mode"
                                       id="address-@address.AddressId"
                                       name="AddressMode"
                                       value="existing"
                                       data-address-id="@address.AddressId"
                                       data-use-new-address="false">
                                <label class="custom-control-label" for="address-@address.AddressId">
                                    @address.Detail, @address.District, @address.City
                                </label>
                            </div>
                        }
                    </div>
                }

                <div class="custom-control custom-radio mb-3">
                    <input type="radio"
                           class="custom-control-input checkout-address-mode"
                           id="useNewAddress"
                           name="AddressMode"
                           value="new"
                           checked
                           data-use-new-address="true">
                    <label class="custom-control-label" for="useNewAddress">Use a new address</label>
                </div>

                <input type="hidden" asp-for="UseNewAddress" id="UseNewAddressValue" value="true" />
                <input type="hidden" asp-for="SelectedAddressId" id="SelectedAddressIdValue" />

                <div class="checkout-card p-30 mb-5">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>First Name</label>
                            <input class="form-control" asp-for="NewAddress.Name" type="text" placeholder="John">
                        </div>

                        <div class="col-md-6 form-group">
                            <label>Last Name</label>
                            <input class="form-control" asp-for="NewAddress.Surname" type="text" placeholder="Doe">
                        </div>

                        <div class="col-md-6 form-group">
                            <label>E-mail</label>
                            <input class="form-control" asp-for="NewAddress.Email" type="text" placeholder="example@email.com">
                        </div>

                        <div class="col-md-6 form-group">
                            <label>Mobile No</label>
                            <input class="form-control" asp-for="NewAddress.Phone" type="text" placeholder="+123 456 789">
                        </div>

                        <div class="col-md-6 form-group">
                            <label>Address Line 1</label>
                            <input class="form-control" asp-for="NewAddress.Detail1" type="text" placeholder="123 Street">
                        </div>

                        <div class="col-md-6 form-group">
                            <label>Address Line 2</label>
                            <input class="form-control" asp-for="NewAddress.Detail2" type="text" placeholder="123 Street">
                        </div>

                        <div class="col-md-6 form-group">
                            <label>Country</label>
                            <input class="form-control" asp-for="NewAddress.Country" type="text" placeholder="United States">
                        </div>

                        <div class="col-md-6 form-group">
                            <label>City</label>
                            <input class="form-control" asp-for="NewAddress.City" type="text" placeholder="New York">
                        </div>

                        <div class="col-md-6 form-group">
                            <label>District</label>
                            <input class="form-control" asp-for="NewAddress.District" type="text" placeholder="New York">
                        </div>

                        <div class="col-md-6 form-group">
                            <label>ZIP Code</label>
                            <input class="form-control" asp-for="NewAddress.ZipCode" type="text" placeholder="123">
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <h5 class="section-title position-relative text-uppercase mb-3">
                    <span class="bg-secondary pr-3">Order Summary</span>
                </h5>

                @await Component.InvokeAsync("_OrderDetailComponentPartial")
            </div>
        </div>
    </div>
</form>

<script>
    document.querySelectorAll('.checkout-address-mode').forEach((input) => {
        input.addEventListener('change', () => {
            const useNewAddress = input.dataset.useNewAddress === 'true';
            document.getElementById('UseNewAddressValue').value = useNewAddress;
            document.getElementById('SelectedAddressIdValue').value = useNewAddress
                ? ''
                : input.dataset.addressId;
        });
    });
</script>
