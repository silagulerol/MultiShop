@model List<ResultProductWithCategoryDto>

<div class="product-list-grid">
    @foreach(var item in Model)
    {
        decimal x = ((item.ProductPrice / 100) * 15) + item.ProductPrice;
        <article class="listing-product-card">
            <div class="listing-product-media">
                <img src="@item.ProductImageUrl" alt="@item.ProductName">
                <div class="listing-product-actions">
                    <a href="" aria-label="Add to cart"><i class="fa fa-shopping-cart"></i></a>
                    <a href="" aria-label="Add to favorites"><i class="far fa-heart"></i></a>
                    <a href="" aria-label="Compare"><i class="fa fa-sync-alt"></i></a>
                    <a href="" aria-label="View product"><i class="fa fa-search"></i></a>
                </div>
            </div>

            <div class="listing-product-body">
                <a class="listing-product-title" href="">@item.ProductName</a>
                <div class="listing-product-price">
                    <span>$@item.ProductPrice</span>
                    <del>$@x</del>
                </div>
                <div class="listing-product-rating">
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                    <small>(99)</small>
                </div>
            </div>
        </article>
    }
</div>
