@model List<ResultFeatureDto>

<section class="service-features-section">
    <div class="service-features-shell">
        @foreach (var item in Model)
        {
            <article class="service-feature-card">
                <div class="service-feature-icon" aria-hidden="true">
                    <i class="@item.IconUrl"></i>
                </div>

                <div class="service-feature-content">
                    <h3>@item.Title</h3>
                </div>
            </article>
        }
    </div>
</section>
