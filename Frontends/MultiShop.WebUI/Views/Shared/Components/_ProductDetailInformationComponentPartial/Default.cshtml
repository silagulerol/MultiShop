@model UpdateProductDetailDto

<div class="tab-pane fade" id="tab-pane-2">
    <h4 class="mb-3">Additional Information</h4>
    <p>@Model.ProductInformation</p>

    @if (Model.Specifications != null && Model.Specifications.Any())
    {
        <h5 class="mt-4 mb-3">Specifications</h5>
        <div class="table-responsive">
            <table class="table table-bordered mb-4">
                <tbody>
                    @foreach (var specification in Model.Specifications)
                    {
                        <tr>
                            <th style="width: 35%;">@specification.Key</th>
                            <td>@specification.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="row">
        @if (!string.IsNullOrWhiteSpace(Model.Material))
        {
            <div class="col-md-6 mb-3">
                <strong>Material</strong>
                <p class="mb-0">@Model.Material</p>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.CareInstructions))
        {
            <div class="col-md-6 mb-3">
                <strong>Care Instructions</strong>
                <p class="mb-0">@Model.CareInstructions</p>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.PackageContent))
        {
            <div class="col-md-6 mb-3">
                <strong>Package Content</strong>
                <p class="mb-0">@Model.PackageContent</p>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.WarrantyInfo))
        {
            <div class="col-md-6 mb-3">
                <strong>Warranty</strong>
                <p class="mb-0">@Model.WarrantyInfo</p>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.SafetyInfo))
        {
            <div class="col-md-6 mb-3">
                <strong>Safety Info</strong>
                <p class="mb-0">@Model.SafetyInfo</p>
            </div>
        }
    </div>
</div>
