@model List<ResultProductImageDto>

@{
    var images = (Model ?? new List<ResultProductImageDto>())
        .OrderByDescending(x => x.IsMainImage)
        .ThenBy(x => x.DisplayOrder)
        .ToList();
}

<div class="col-lg-5 mb-30">
    <div id="product-carousel" class="carousel slide product-detail-carousel" data-ride="carousel">
        <div class="carousel-inner bg-light">
            @if (images.Any())
            {
                @for (var i = 0; i < images.Count; i++)
                {
                    var image = images[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <img class="product-detail-img" src="@image.ImageUrl" alt="@(image.ImageAltText ?? "Product image")">
                    </div>
                }
            }
            else
            {
                <div class="carousel-item active">
                    <img class="product-detail-img" src="/multishop/img/no-image.png" alt="Product image">
                </div>
            }
        </div>

        @if (images.Count > 1)
        {
            <a class="carousel-control-prev" href="#product-carousel" data-slide="prev">
                <i class="fa fa-2x fa-angle-left text-dark"></i>
            </a>
            <a class="carousel-control-next" href="#product-carousel" data-slide="next">
                <i class="fa fa-2x fa-angle-right text-dark"></i>
            </a>
        }
    </div>
</div>

<style>
    .product-detail-carousel {
        width: 100%;
        height: 480px;
        background-color: #f8f8f8;
        border-radius: 12px;
        overflow: hidden;
    }

    .product-detail-carousel .carousel-inner,
    .product-detail-carousel .carousel-item {
        width: 100%;
        height: 100%;
    }

    .product-detail-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
        display: block;
        background-color: #f8f8f8;
    }

    @@media (max-width: 991.98px) {
        .product-detail-carousel {
            height: 430px;
        }
    }

    @@media (max-width: 575.98px) {
        .product-detail-carousel {
            height: 360px;
        }
    }
</style>
