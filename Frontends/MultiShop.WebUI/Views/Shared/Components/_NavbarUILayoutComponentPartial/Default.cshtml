@model List<ResultCategoryDto>

@{
    var accountDisplayName = User.Identity?.Name
        ?? User.Claims.FirstOrDefault(x => x.Type == "name")?.Value
        ?? User.Claims.FirstOrDefault(x => x.Type == "preferred_username")?.Value
        ?? User.Claims.FirstOrDefault(x => x.Type == "email")?.Value
        ?? "My Account";

    var isCustomer = User.IsInRole("Customer");
    var isVendor = User.IsInRole("Vendor");
    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
    var accountHomeUrl = isVendor ? "/Vendor/Product/Index" : "/MyProfile/MyOrders";
    var accountLabel = isVendor ? "Vendor Panel" : accountDisplayName;
}

<div class="container-fluid bg-dark mb-0">
    <div class="row px-xl-5">
        <div class="col-lg-12">
            <nav class="navbar navbar-expand-lg bg-dark navbar-dark py-3 py-lg-0 px-0">
                <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#navbarCollapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse navbar-marketplace-collapse" id="navbarCollapse">
                    <div class="navbar-nav mr-auto py-0 navbar-main-links">
                        <a href="/Default/Index/" class="nav-item nav-link">Home</a>

                        @if (!isAuthenticated)
                        {
                            <div class="nav-item dropdown register-dropdown">
                                <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">
                                    Register
                                </a>
                                <div class="dropdown-menu rounded-0 border-0 m-0">
                                    <a href="/Register/CustomerRegister/" class="dropdown-item">Customer Register</a>
                                    <a href="/Register/VendorRegister/" class="dropdown-item">Vendor Register</a>
                                </div>
                            </div>
                        }

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="nav-item dropdown account-dropdown">
                                <a href="@accountHomeUrl"
                                   class="nav-link account-dropdown-toggle"
                                   id="accountDropdown"
                                   role="button"
                                   data-toggle="dropdown"
                                   aria-haspopup="true"
                                   aria-expanded="false">
                                    <span class="account-avatar">
                                        <i class="fas fa-user"></i>
                                    </span>
                                    <span class="account-trigger-text">
                                        <span class="account-trigger-kicker">Account</span>
                                        <span class="account-trigger-name">@accountLabel</span>
                                    </span>
                                    <i class="fas fa-chevron-down account-chevron"></i>
                                </a>

                                <div class="dropdown-menu account-menu" aria-labelledby="accountDropdown">
                                    <div class="account-menu-header">
                                        <span class="account-menu-avatar">
                                            <i class="fas fa-user"></i>
                                        </span>
                                        <span>
                                            <strong>@accountLabel</strong>
                                            <small>@(isVendor ? "Marketplace seller" : "MultiShop member")</small>
                                        </span>
                                    </div>

                                    @if (isVendor)
                                    {
                                        <a href="/Vendor/Product/Index" class="dropdown-item account-menu-item active">
                                            <i class="fas fa-box-open"></i>
                                            <span>My Products</span>
                                        </a>
                                        <a href="/Vendor/Product/CreateProduct" class="dropdown-item account-menu-item">
                                            <i class="fas fa-plus-circle"></i>
                                            <span>Add New Product</span>
                                        </a>
                                        <a href="/Vendor/Order/OrderDetailList" class="dropdown-item account-menu-item">
                                            <i class="fas fa-clipboard-list"></i>
                                            <span>Order Management</span>
                                        </a>
                                        <a href="/Vendor/Statistic/Index" class="dropdown-item account-menu-item">
                                            <i class="fas fa-chart-line"></i>
                                            <span>Statistics</span>
                                        </a>
                                        <a href="/Vendor/Message/Index" class="dropdown-item account-menu-item">
                                            <i class="fas fa-envelope"></i>
                                            <span>Messages</span>
                                        </a>
                                        <a href="/Vendor/Profile/Index" class="dropdown-item account-menu-item">
                                            <i class="fas fa-store"></i>
                                            <span>Vendor Profile</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="/MyProfile/MyOrders" class="dropdown-item account-menu-item active">
                                            <i class="fas fa-shopping-bag"></i>
                                            <span>My Orders</span>
                                        </a>
                                        <a href="/Favorite/Index" class="dropdown-item account-menu-item">
                                            <i class="fas fa-heart"></i>
                                            <span>Favorites</span>
                                        </a>
                                        <a href="/Discount/Index" class="dropdown-item account-menu-item">
                                            <i class="fas fa-ticket-alt"></i>
                                            <span>Discount Coupons</span>
                                        </a>
                                        <a href="/Message/Index" class="dropdown-item account-menu-item">
                                            <i class="fas fa-envelope"></i>
                                            <span>Messages</span>
                                        </a>
                                        <a href="/MyProfile/AddressInformation" class="dropdown-item account-menu-item">
                                            <i class="fas fa-map-marker-alt"></i>
                                            <span>Address Information</span>
                                        </a>
                                        <a href="/MyProfile/AccountSettings" class="dropdown-item account-menu-item">
                                            <i class="fas fa-cog"></i>
                                            <span>Account Settings</span>
                                        </a>
                                    }

                                    <div class="dropdown-divider account-menu-divider"></div>
                                    <a href="/LogIn/LogOut" class="dropdown-item account-menu-item account-menu-logout">
                                        <i class="fas fa-sign-out-alt"></i>
                                        <span>Logout</span>
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a href="/LogIn/Index/" class="nav-item nav-link">Log In</a>
                        }
                        <a href="/Contact/Index/" class="nav-item nav-link">Contact</a>
                    </div>

                    <form asp-controller="ProductList" asp-action="Search" method="get" class="navbar-search-form">
                        <div class="navbar-search-shell">
                            <i class="fas fa-search navbar-search-icon"></i>

                            <input type="text"
                                name="search"
                                class="navbar-search-input"
                                placeholder="Search for products"
                                aria-label="Search for products" />

                            <button type="submit" class="navbar-search-submit" aria-label="Search">
                                <i class="fas fa-arrow-right"></i>
                            </button>
                        </div>
                    </form>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="navbar-nav ml-auto py-0 auth-actions">
                            <a href="/Favorite/Index" class="navbar-action-link">
                                <i class="fas fa-heart"></i>
                                <span>Favorites</span>
                            </a>
                            <a href="/ShoppingCart/Index/" class="navbar-action-link basket-action-link">
                                <i class="fas fa-shopping-cart"></i>
                                <span>My Basket</span>
                                <span class="navbar-action-badge">0</span>
                            </a>
                        </div>
                    }
                </div>
            </nav>
        </div>
    </div>
</div>

<div class="container-fluid bg-white border-bottom category-horizontal-wrapper">
    <div class="row px-xl-5">
        <div class="col-lg-12">
            <nav class="category-horizontal-menu d-flex align-items-center">
                <a href="/ProductList/WomenEntrepreneurProducts/" class="category-horizontal-link special-link">
                    Women Entrepreneur Products
                </a>

                <a href="/ProductList/RecyclableProducts/" class="category-horizontal-link special-link">
                    Recyclable Products
                </a>

                @foreach (var item in Model)
                {
                    <a href="/ProductList/Index/@item.CategoryId" class="category-horizontal-link">
                        @item.Name
                    </a>
                }

                <a href="/ProductList/BestSellers/" class="category-horizontal-link ml-auto">
                    Best Sellers
                </a>

                <a href="/ProductList/FlashDeals/" class="category-horizontal-link flash-link">
                    Flash Deals
                </a>
            </nav>
        </div>
    </div>
</div>

<style>
    .category-horizontal-wrapper {
        min-height: 54px;
        overflow-x: auto;
        white-space: nowrap;
    }

    .category-horizontal-menu {
        min-height: 54px;
        gap: 26px;
        overflow-x: auto;
        scrollbar-width: none;
    }

    .category-horizontal-menu::-webkit-scrollbar {
        display: none;
    }

    .category-horizontal-link {
        color: #343a40;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        padding: 16px 0 13px 0;
        border-bottom: 3px solid transparent;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .category-horizontal-link:hover {
        color: #f27a1a;
        border-bottom-color: #f27a1a;
        text-decoration: none;
    }

    .special-link {
        color: #f27a1a;
        font-weight: 700;
    }

    .flash-link {
        color: #dc3545;
        font-weight: 700;
    }

    .navbar-marketplace-collapse {
        align-items: center;
        gap: 18px;
    }

    .navbar-main-links {
        align-items: center;
        flex: 0 0 auto;
    }

    .navbar-search-wrapper {
        flex: 1 1 420px;
        max-width: 580px;
        min-width: 260px;
        margin: 0 8px;
    }

    .navbar-search-form {
        width: 100%;
        margin: 0;
    }

    .navbar-search-shell {
        display: flex;
        align-items: center;
        min-height: 44px;
        padding: 0 6px 0 16px;
        background: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 999px;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .navbar-search-shell:hover {
        box-shadow: 0 13px 30px rgba(0, 0, 0, 0.2);
        transform: translateY(-1px);
    }

    .navbar-search-shell:focus-within {
        border-color: #f27a1a;
        box-shadow: 0 0 0 3px rgba(242, 122, 26, 0.18), 0 14px 32px rgba(0, 0, 0, 0.22);
        transform: translateY(-1px);
    }

    .navbar-search-icon {
        flex: 0 0 auto;
        color: #f27a1a;
        font-size: 14px;
    }

    .navbar-search-input {
        flex: 1 1 auto;
        min-width: 0;
        height: 42px;
        padding: 0 12px;
        color: #212529;
        background: transparent;
        border: 0;
        outline: 0;
        font-size: 14px;
        font-weight: 600;
    }

    .navbar-search-input::placeholder {
        color: #8b95a1;
        font-weight: 500;
    }

    .navbar-search-submit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        color: #ffffff;
        background: #f27a1a;
        border: 0;
        border-radius: 50%;
        font-size: 12px;
        cursor: pointer;
        transition: background-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
    }

    .navbar-search-submit:hover,
    .navbar-search-submit:focus {
        background: #ff8a2a;
        box-shadow: 0 8px 18px rgba(242, 122, 26, 0.28);
        outline: 0;
        transform: translateX(1px);
    }

    .account-dropdown {
        position: relative;
    }

    .register-dropdown .dropdown-menu {
        min-width: 210px;
        padding: 8px;
        margin-top: 0;
        background: #ffffff;
        border-radius: 10px !important;
        box-shadow: 0 16px 36px rgba(15, 23, 42, 0.16);
    }

    .register-dropdown .dropdown-item {
        padding: 9px 12px;
        color: #343a40;
        font-size: 14px;
        font-weight: 600;
        border-radius: 7px;
        transition: background-color 0.18s ease, color 0.18s ease;
    }

    .register-dropdown .dropdown-item:hover,
    .register-dropdown .dropdown-item:focus {
        color: #f27a1a;
        background: #f8f9fa;
    }

    .account-dropdown-toggle {
        display: flex;
        align-items: center;
        gap: 9px;
        min-height: 52px;
        padding-right: 18px !important;
        padding-left: 14px !important;
        color: #f8f9fa !important;
        border-radius: 8px;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .account-dropdown-toggle::after {
        display: none;
    }

    .account-dropdown-toggle:hover,
    .account-dropdown.show .account-dropdown-toggle {
        color: #ffffff !important;
        background-color: rgba(255, 255, 255, 0.08);
        text-decoration: none;
    }

    .account-avatar,
    .account-menu-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        color: #f27a1a;
        background: #fff4ec;
        border: 1px solid rgba(242, 122, 26, 0.18);
        border-radius: 50%;
    }

    .account-trigger-text {
        display: flex;
        flex-direction: column;
        min-width: 0;
        line-height: 1.15;
    }

    .account-trigger-kicker {
        color: #adb5bd;
        font-size: 11px;
        font-weight: 600;
    }

    .account-trigger-name {
        max-width: 150px;
        overflow: hidden;
        color: #ffffff;
        font-size: 14px;
        font-weight: 700;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .account-chevron {
        color: #adb5bd;
        font-size: 11px;
        transition: transform 0.22s ease;
    }

    .account-dropdown.show .account-chevron,
    .account-dropdown:hover .account-chevron {
        transform: rotate(180deg);
    }

    .account-menu {
        display: block;
        width: min(320px, calc(100vw - 30px));
        min-width: 280px;
        padding: 10px;
        margin-top: 10px;
        overflow: hidden;
        visibility: hidden;
        background: #ffffff;
        border: 1px solid #edf0f3;
        border-radius: 12px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.16);
        opacity: 0;
        transform: translateY(10px) scale(0.98);
        transform-origin: top right;
        transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
    }

    .account-dropdown:hover > .account-menu,
    .account-dropdown.show > .account-menu {
        visibility: visible;
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    .account-menu-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 8px 12px;
        margin-bottom: 4px;
        border-bottom: 1px solid #f1f3f5;
    }

    .account-menu-header strong,
    .account-menu-header small {
        display: block;
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .account-menu-header strong {
        color: #212529;
        font-size: 14px;
        font-weight: 700;
    }

    .account-menu-header small {
        margin-top: 2px;
        color: #8b95a1;
        font-size: 12px;
        font-weight: 500;
    }

    .account-menu-item {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 42px;
        padding: 10px 11px;
        color: #343a40;
        font-size: 14px;
        font-weight: 600;
        border-radius: 8px;
        transition: background-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
    }

    .account-menu-item i {
        width: 18px;
        color: #9aa3ad;
        font-size: 14px;
        text-align: center;
        transition: color 0.18s ease;
    }

    .account-menu-item:hover,
    .account-menu-item:focus,
    .account-menu-item.active {
        color: #f27a1a;
        background: #f8f9fa;
        text-decoration: none;
        transform: translateX(2px);
    }

    .account-menu-item:hover i,
    .account-menu-item:focus i,
    .account-menu-item.active i {
        color: #f27a1a;
    }

    .account-menu-divider {
        margin: 8px 4px;
        border-top-color: #f1f3f5;
    }

    .account-menu-logout {
        color: #495057;
    }

    .account-menu-logout:hover,
    .account-menu-logout:focus {
        color: #dc3545;
        background: #fff5f5;
    }

    .account-menu-logout:hover i,
    .account-menu-logout:focus i {
        color: #dc3545;
    }

    .auth-actions {
        align-items: center;
        gap: 8px;
        flex: 0 0 auto;
    }

    .navbar-action-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 8px 12px;
        color: #f8f9fa;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0;
        border-radius: 8px;
        transition: color 0.18s ease, background-color 0.18s ease, opacity 0.18s ease, transform 0.18s ease;
    }

    .navbar-action-link i {
        color: #f27a1a;
        font-size: 16px;
        transition: color 0.18s ease, transform 0.18s ease;
    }

    .navbar-action-link:hover,
    .navbar-action-link:focus {
        color: #f27a1a;
        background: rgba(255, 255, 255, 0.07);
        text-decoration: none;
        transform: translateY(-1px);
    }

    .navbar-action-link:hover i,
    .navbar-action-link:focus i {
        color: #ff9b45;
        transform: scale(1.05);
    }

    .basket-action-link {
        padding-right: 10px;
    }

    .navbar-action-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        padding: 0 6px;
        color: #ffffff;
        background: #f27a1a;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        line-height: 1;
    }

    @@media (max-width: 991.98px) {
        .navbar-marketplace-collapse {
            align-items: stretch;
            gap: 0;
            padding-top: 10px;
        }

        .navbar-main-links {
            align-items: stretch;
            width: 100%;
        }

        .navbar-search-wrapper {
            width: 100%;
            max-width: 100%;
            min-width: 0;
            flex-basis: 100%;
            margin: 10px 0 6px;
        }

        .navbar-search-shell {
            min-height: 42px;
            box-shadow: none;
        }

        .navbar-search-input {
            height: 40px;
        }

        .account-dropdown-toggle {
            width: 100%;
            justify-content: flex-start;
            min-height: 50px;
            margin: 4px 0;
            padding-left: 0 !important;
        }

        .account-trigger-name {
            max-width: calc(100vw - 150px);
        }

        .account-chevron {
            margin-left: auto;
        }

        .account-menu {
            position: static;
            width: 100%;
            min-width: 100%;
            margin: 4px 0 10px;
            box-shadow: 0 12px 28px rgba(15, 23, 42, 0.14);
            transform-origin: top left;
        }

        .account-menu-header strong,
        .account-menu-header small {
            max-width: calc(100vw - 120px);
        }

        .auth-actions {
            flex-direction: row;
            align-items: center;
            justify-content: flex-start;
            gap: 12px;
            padding: 10px 0 2px;
            margin-left: 0 !important;
        }

        .navbar-action-link {
            justify-content: flex-start;
            min-height: 42px;
            padding: 8px 10px;
        }
    }
</style>
