@model List<ResultProductDto>

<section class="featured-products-section">
    <div class="featured-products-shell">
        <div class="featured-products-header">
            <h2 style="color: #0c0c0c;">Featured Products</h2>
        </div>

        @foreach(var item in Model)
        {
            decimal x = ((item.ProductPrice / 100) * 15) + item.ProductPrice;
            <article class="featured-product-card">
                <div class="featured-product-media">
                    <a href="/ProductList/ProductDetail/@item.ProductId" aria-label="@item.ProductName">
                        <img src="@item.ProductImageUrl" alt="@item.ProductName">
                    </a>

                    <div class="featured-product-actions">
                        <a href="/ShoppingCart/AddBasketItem/@item.ProductId" aria-label="Add to cart"><i class="fa fa-shopping-cart"></i></a>
                        <a href="" aria-label="Add to favorites"><i class="far fa-heart"></i></a>
                        <a href="" aria-label="Compare"><i class="fa fa-sync-alt"></i></a>
                        <a href="/ProductList/ProductDetail/@item.ProductId" aria-label="View product"><i class="fa fa-search"></i></a>
                    </div>
                </div>

                <div class="featured-product-body">
                    <a class="featured-product-title" href="/ProductList/ProductDetail/@item.ProductId">@item.ProductName</a>

                    <div class="featured-product-price">
                        <span>$@item.ProductPrice</span>
                        <del>$@x</del>
                    </div>

                    <div class="featured-product-rating" aria-label="5 star rating">
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <small>(25)</small>
                    </div>
                </div>
            </article>
        }
    </div>
</section>
