@model BasketTotalDto

<div class="cart-items-list">
    @if (Model?.BasketItems == null || !Model.BasketItems.Any())
    {
        <div class="cart-empty-state">
            <div class="cart-empty-icon">
                <i class="fa fa-shopping-bag"></i>
            </div>
            <h2>Your cart is empty</h2>
            <p>Discover new season pieces and add your favorites to your bag.</p>
            <a href="/ProductList/Index/" class="cart-empty-link">Continue Shopping</a>
        </div>
    }
    else
    {
        @foreach(var item in Model.BasketItems)
        {
            var imageUrl = !string.IsNullOrWhiteSpace(item.ProductImageUrl)
                ? item.ProductImageUrl
                : Url.Content("~/multishopTemp/img/product-1.jpg");
            var sellerText = !string.IsNullOrWhiteSpace(item.VendorId)
                ? item.VendorId
                : "Seller information unavailable";

            <article class="cart-item-card">
                <a class="cart-item-image" href="/ProductList/ProductDetail/@item.ProductId">
                    <img src="@imageUrl" alt="@item.ProductName">
                </a>

                <div class="cart-item-info">
                    <div>
                        <a class="cart-item-title" href="/ProductList/ProductDetail/@item.ProductId">@item.ProductName</a>
                        <div class="cart-item-meta">
                            @if (!string.IsNullOrWhiteSpace(item.Color))
                            {
                                <span>Color: @item.Color</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Size))
                            {
                                <span>Size: @item.Size</span>
                            }
                            <span>Seller: @sellerText</span>
                        </div>
                    </div>

                    <div class="cart-item-unit-price">@item.UnitPrice ₺</div>
                </div>

                <div class="cart-item-controls">
                    <div class="input-group quantity cart-quantity">
                        <div class="input-group-btn">
                            <button class="btn btn-sm btn-minus" type="button">
                                <i class="fa fa-minus"></i>
                            </button>
                        </div>
                        <input type="text" class="form-control form-control-sm text-center" value="@item.Quantity">
                        <div class="input-group-btn">
                            <button class="btn btn-sm btn-plus" type="button">
                                <i class="fa fa-plus"></i>
                            </button>
                        </div>
                    </div>

                    <a class="cart-remove-btn" href="/ShoppingCart/RemoveBasketItem/@(item.ProductVariantId ?? item.ProductId)" aria-label="Remove @item.ProductName">
                        <i class="fa fa-times"></i>
                    </a>
                </div>

                <div class="cart-item-total">
                    <span>Total</span>
                    <strong>@(item.Quantity* item.UnitPrice) ₺</strong>
                </div>
            </article>
        }
    }
</div>
